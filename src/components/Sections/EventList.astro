---
import { getCollection } from "astro:content";
import EventCard from "../Cards/EventCard.astro";
import FeaturedEventCard from "../Cards/FeaturedEventCard.astro";
import Button from "../UI/Button.astro";

export interface Props {
  count?: number;
  showViewAll?: boolean;
}

const { count = 3, showViewAll = true } = Astro.props;

// Get events sorted by date (newest first)
const allEvents = await getCollection("events", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by date (upcoming first)
const events = allEvents
  .filter((event) => new Date(event.data.date) >= new Date()) // Only future events
  .sort(
    (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
  )
  .slice(0, count);
---

<section class="py-16 bg-gray-50">
  <div class="container">

    {
      events.length > 0 ? (
        <>
          <div class="space-y-8">
            {events.slice(0, 2).map((event) => (
              <FeaturedEventCard event={event} />
            ))}
          </div>

          {events.length > 2 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
              {events.slice(2).map((event) => (
                <EventCard event={event} variant="upcoming" />
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-12 bg-white rounded-lg">
          <p class="text-gray-600">
            No upcoming events scheduled right now — check back soon!
          </p>
        </div>
      )
    }

    {
      showViewAll && events.length > 0 && (
        <div class="mt-12 text-center">
          <Button href="/events" variant="outline">
            View All Events
          </Button>
        </div>
      )
    }
  </div>
</section>
