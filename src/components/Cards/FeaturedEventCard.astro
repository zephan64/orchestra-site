---
import Button from "../UI/Button.astro";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/dateUtils";

export interface Props {
    event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const formattedDate = formatDate(event.data.date, "MMMM d");
---

<div
    class="grid grid-cols-1 md:grid-cols-5 rounded-xl overflow-hidden shadow-lg bg-white"
>
    <div class="md:col-span-3 aspect-video md:aspect-auto md:h-full">
        <img
            src={event.data.image}
            alt={event.data.title}
            class="w-full h-full object-cover"
        />
    </div>

    <div class="md:col-span-2 p-8 md:p-10 flex flex-col justify-center">
        <p
            class="text-primary-600 font-semibold uppercase tracking-wide text-md mb-2"
        >
            Upcoming Event
        </p>
        <h3 class="text-3xl md:text-4xl font-bold mb-4">{event.data.title}</h3>

        <div class="space-y-2 mb-6 text-gray-600">
            {
                event.data.showtimes && event.data.showtimes.length > 0 ? (
                    event.data.showtimes.map((showtime) => (
                        <div class="flex items-start">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2 mt-0.5 flex-shrink-0"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                            </svg>
                            <span>
                                {formatDate(showtime.date, "MMMM d")} —{" "}
                                {showtime.time} @ {showtime.location}
                            </span>
                        </div>
                    ))
                ) : (
                    <>
                        <div class="flex items-center">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                            </svg>
                            <span>
                                {formattedDate}
                                {event.data.time && ` — ${event.data.time}`}
                            </span>
                        </div>

                        <div class="flex items-center">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                />
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                />
                            </svg>
                            <span>{event.data.location}</span>
                        </div>
                    </>
                )
            }
        </div>

        <p class="text-gray-700 mb-8 text-lg">{event.data.summary}</p>

        {
            event.data.registrationLink ? (
                <Button
                    href={event.data.registrationLink}
                    variant="primary"
                    size="lg"
                    target="_blank"
                    class="w-fit"
                >
                    Get Tickets
                </Button>
            ) : (
                <Button
                    href={`/events/${event.id}`}
                    variant="outline"
                    size="lg"
                    class="w-fit"
                >
                    Details Coming Soon
                </Button>
            )
        }
    </div>
</div>
