---
import Button from "../UI/Button.astro";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/dateUtils";

export interface Props {
  concert: CollectionEntry<"concerts">;
}

const { concert } = Astro.props;
const formattedDate = formatDate(concert.data.date);
---

<div class="bg-gray-50 p-6 rounded-lg shadow-sm sticky top-24">
  <h3 class="font-bold mb-4">Concert Information</h3>

  <div class="space-y-4 mb-6">
    <div>
      <h4 class="font-bold text-gray-700 mb-1">Featured Artist</h4>
      <p>{concert.data.speaker}</p>
    </div>

    {
      concert.data.series && (
        <div>
          <h4 class="font-bold text-gray-700 mb-1">Series</h4>
          <p>{concert.data.series}</p>
        </div>
      )
    }

    <div>
      <h4 class="font-bold text-gray-700 mb-1">Date</h4>
      <p>{formattedDate}</p>
    </div>

    {
      concert.data.location && (
        <div>
          <h4 class="font-bold text-gray-700 mb-1">Location</h4>
          <p>{concert.data.location}</p>
        </div>
      )
    }

    {
      concert.data.tags && concert.data.tags.length > 0 && (
        <div>
          <h4 class="font-bold text-gray-700 mb-2">Tags</h4>
          <div class="flex flex-wrap gap-2">
            {concert.data.tags.map((tag) => (
              <span class="px-2 py-1 text-xs font-medium text-primary-700 bg-primary-100 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-col space-y-3">
    <Button href="/concerts" variant="outline"> Back to All Concerts </Button>

    <Button href="/contact?subject=Concert+Question" variant="outline">
      Have a Question?
    </Button>
  </div>
</div>
