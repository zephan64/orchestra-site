---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import EventCard from "../../components/Cards/EventCard.astro";
import FeaturedEventCard from "../../components/Cards/FeaturedEventCard.astro";
import ConcertCard from "../../components/Cards/ConcertCard.astro";
import { getCollection } from "astro:content";
import { isFutureDate } from "../../utils/dateUtils";
import Button from "../../components/UI/Button.astro";

// Get all events
const allEvents = await getCollection("events", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Only need upcoming events now
const upcomingEvents = allEvents
  .filter((event) => isFutureDate(event.data.date))
  .sort(
    (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
  );

// Get most recent concerts from the archive
const allConcerts = await getCollection("concerts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const recentConcerts = allConcerts
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Events - The Orchestra on the Hill"
  description="Stay updated with upcoming concerts and events from The Orchestra on the Hill."
>
  <PageHeader
    title="Upcoming Events"
    subtitle="Join us for an upcoming performance"
    backgroundImage="/uploads/people-painting.jpg"
    backgroundPosition="center 80%"
  />

  <!-- Upcoming Events -->
  <section class="py-16">
    <div class="container">
      <!--
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Upcoming Events</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Mark your calendar and join us for these upcoming events
        </p>
      </div>
    -->

      {
        upcomingEvents.length > 0 ? (
          <>
            <FeaturedEventCard event={upcomingEvents[0]} />

            {upcomingEvents.length > 1 && (
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
                {upcomingEvents.slice(1).map((event) => (
                  <EventCard event={event} variant="upcoming" />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="text-center py-12 bg-gray-50 rounded-lg">
            <p class="text-gray-600">
              No upcoming events scheduled right now — check back soon!
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Recent Performances -->
  {
    recentConcerts.length > 0 && (
      <section class="py-16 bg-gray-50">
        <div class="container">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Past Concerts</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
              Take a look back at some of our recent performances
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {recentConcerts.map((concert) => (
              <ConcertCard concert={concert} />
            ))}
          </div>

          <div class="mt-12 text-center">
            <Button href="/concerts" variant="outline">
              View All Concerts
            </Button>
          </div>
        </div>
      </section>
    )
  }

  <!-- Add Your Event CTA -->
  <section class="py-20 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Interested in Collaborating?
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          If you're a musician, artist, or organization interested in performing 
          <br/> or collaborating with us, we'd love to hear from you.
        </p>

        <a
          href="/contact?subject=Collaboration+Inquiry"
          class="inline-flex items-center justify-center px-5 py-3 text-base font-medium text-white bg-primary-600 rounded-md shadow-sm hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
