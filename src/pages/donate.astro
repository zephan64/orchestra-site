---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import Button from "../components/UI/Button.astro";

const donateLink =
  "https://www.paypal.com/donate/?hosted_button_id=SNK3YB537NK5C";

const individualLevels = [
  { tier: "Friend", amount: "$100–$500" },
  { tier: "Patron", amount: "$501–$1,000" },
  { tier: "Benefactor", amount: "$1,000–$5,000" },
  { tier: "Maestro's Circle", amount: "$5,000+" },
  { tier: "Presenting Chair", amount: "$20,000+" },
];

const corporateLevels = [
  { tier: "Sponsor", amount: "$500–$2,500" },
  { tier: "Premier", amount: "$2,500–$5,000" },
  { tier: "Champion of the Arts", amount: "$5,000–$10,000" },
  { tier: "Charter Partner", amount: "$10,000+" },
  { tier: "Presenting Partner", amount: "$25,000+" },
];
---

<BaseLayout
  title="Donate - The Orchestra on the Hill"
  description="Support The Orchestra on the Hill"
>
  <PageHeader
    title="Support Our Orchestra"
    subtitle="Keep the music playing!"
    backgroundImage="/uploads/dancing-painting.jpg"
    backgroundPosition="center 30%"
  />

  <!-- Why Your Support Matters -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center">
          Why Your Support Matters
        </h2>

        <p class="text-lg text-gray-700 mb-4">
          The Orchestra on the Hill depends on your generosity to bring
          innovative original music and multimedia events to the Ipswich
          community and beyond. Your donation in any amount is always
          appreciated!
        </p>

        <p class="text-lg text-gray-700 mb-6">Your gift will help us:</p>

        <ul class="space-y-3 mb-10 text-lg text-gray-700 pl-6">
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span
              >Support musicians, composers, dancers, storytellers, and cultural
              artists</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span>Commission original music and creative work</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span>Build meaningful partnerships with cultural communities</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span
              >Create opportunities for audiences to experience and understand
              other cultures</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span>Keep performances free and accessible to everyone</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">•</span>
            <span
              >Build An American Tapestry into a lasting annual cultural
              initiative</span
            >
          </li>
        </ul>

        <!--
        <div class="bg-gray-50 rounded-lg p-8 mb-10">
          <h3 class="text-2xl font-bold mb-4">
            This is bigger than one concert.
          </h3>
          <p class="text-lg text-gray-700 mb-4">
            The Cambodian Spirit is the first thread in a much larger tapestry.
            Early supporters are helping establish the artistic, community, and
            financial foundation for what comes next.
          </p>
          <p class="text-lg text-gray-700 font-medium">
            Your gift today is not simply helping produce a concert. It is
            helping launch a vision.
          </p>
        </div>
      -->

        <!-- Donate Button -->
        <div class="text-center">
          <Button href={donateLink} variant="primary" size="lg" target="_blank">
            Donate via PayPal
          </Button>
          <p class="text-sm text-gray-500 mb-16 mt-4">
            You'll be securely redirected to PayPal to complete your donation.
          </p>
        </div>
      </div>
    </div>


  <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center">
    Support Levels
  </h2>

  <!-- Giving Levels -->
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-2xl font-bold mb-6 text-center">
              Individual & Family
            </h3>
            <div class="bg-white rounded-lg shadow-sm overflow-hidden">
              {
                individualLevels.map((level, i) => (
                  <div
                    class:list={[
                      "flex justify-between items-center px-6 py-4",
                      i !== individualLevels.length - 1 &&
                        "border-b border-gray-100",
                    ]}
                  >
                    <span class="font-medium text-gray-900">{level.tier}</span>
                    <span class="text-gray-600">{level.amount}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <h3 class="text-2xl font-bold mb-6 text-center">
              Corporate & Foundation
            </h3>
            <div class="bg-white rounded-lg shadow-sm overflow-hidden">
              {
                corporateLevels.map((level, i) => (
                  <div
                    class:list={[
                      "flex justify-between items-center px-6 py-4",
                      i !== corporateLevels.length - 1 &&
                        "border-b border-gray-100",
                    ]}
                  >
                    <span class="font-medium text-gray-900">{level.tier}</span>
                    <span class="text-gray-600">{level.amount}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <p class="text-lg text-center text-gray-600 mt-10 max-w-2xl mx-auto">
          Corporate sponsorship includes recognition through programs, website,
          Instagram posts, signage, and event opportunities, with enhanced
          benefits at higher levels.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
